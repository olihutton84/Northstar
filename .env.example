# Northstar Trading Lab — environment template.
#
# Copy to .env and fill in. Credentials are read from the environment ONLY:
# nothing here is ever persisted to the database, written to a log, or returned
# by the HTTP API.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys.
#
# Every `npm run` bot command loads this file automatically via Node's
# --env-file-if-exists, so no manual `node --env-file=...` is needed. Tests do
# NOT load it, so they behave identically with or without credentials present.
#
# Leaving a variable blank means "not configured" and selects the fixture
# provider. Setting only PART of a credential pair (for example the Alpaca key
# id without its secret) is a hard startup error rather than a silent fallback.

# ---------------------------------------------------------------- runtime --
NODE_ENV=development
LOG_LEVEL=info
NORTHSTAR_DATA_DIR=./data
NORTHSTAR_DB_PATH=./data/northstar.sqlite
NORTHSTAR_PORT=3737

# Identity recorded against manual LIVE approvals.
NORTHSTAR_APPROVER_ID=local-operator

# Run entirely on recorded fixtures: no X, no Tiingo, no Alpaca. Useful for
# development, demos and offline replay.
NORTHSTAR_USE_FIXTURES=false

# ---------------------------------------------------------------------- X --
# X API v2 bearer token. Without it, Northstar falls back to the fixture social
# provider and logs a warning rather than silently pretending to have data.
X_BEARER_TOKEN=
X_API_BASE_URL=https://api.twitter.com/2
# Consecutive X failures tolerated before the strategy auto-pauses.
X_FAILURE_TOLERANCE=3

# ----------------------------------------------------------- market data --
# Tiingo is Northstar's single price vendor. The X bot does not add another.
TIINGO_API_KEY=
TIINGO_BASE_URL=https://api.tiingo.com

# --------------------------------------------------------- Alpaca: PAPER --
# Paper and live credentials are DISJOINT and are never read into the same
# config object. There is no fallback between them in either direction.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# ---------------------------------------------------------- Alpaca: LIVE --
# LIVE requires an explicit opt-in flag AS WELL AS its own credentials.
# With the flag false, a LIVE broker cannot be constructed at all.
#
# Even with live trading enabled, no order reaches Alpaca without a human
# approving that exact order in Trading Lab.
NORTHSTAR_LIVE_TRADING_ENABLED=false
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# Shared market-data host for Alpaca (used for asset metadata only; prices come
# from Tiingo).
ALPACA_DATA_URL=https://data.alpaca.markets

# ------------------------------------------------- cadence and rate control --
# Every value below is OPTIONAL. Each falls back to the default shown, so the
# bot runs correctly with this whole section absent. They are listed because a
# tuning knob nobody can find is not a tuning knob.
#
# These are OPERATIONAL settings, deliberately separate from the frozen
# strategy version: they govern how fast the bot looks and acts, never what it
# believes. Changing one does not republish x-signal-v1.

# --- X polling -------------------------------------------------------------
# Baseline scan cadence. The bot is looking for NEW information, so the useful
# rate is set by how often genuinely new material appears — minutes, not
# seconds. `npm run paper -- --interval N` overrides this for one run.
# NORTHSTAR_X_SCAN_SECONDS=120
# Faster cadence while a material story is developing, and how long that lasts.
# NORTHSTAR_X_EVENT_WATCH_SECONDS=60
# NORTHSTAR_X_EVENT_WATCH_MINUTES=12
# Composite score at or above which a new event triggers the faster cadence.
# NORTHSTAR_X_EVENT_WATCH_SCORE=45
# Cadence once rate-limited, plus the exponential backoff ceiling and the gap
# after which the backoff ladder starts fresh rather than escalating.
# NORTHSTAR_X_PRESSURE_SECONDS=300
# NORTHSTAR_X_MAX_BACKOFF_SECONDS=900
# NORTHSTAR_X_BACKOFF_RESET_MINUTES=30
# How far back the FIRST scan looks, before any cursor exists.
# NORTHSTAR_X_COLD_START_MINUTES=30
# Posts requested per search request (X caps this at 100).
# NORTHSTAR_X_MAX_RESULTS=100
# Runaway guard, NOT a normal-operation throttle. The seeded 29-name universe
# batches into 2 query chunks, so a 6.5h session costs ~390-490 requests; 900
# clears that with headroom while still catching a polling bug within minutes.
# Readiness fails if a projected day would exceed it.
# NORTHSTAR_X_DAILY_SOFT_CAP=900

# --- market data -----------------------------------------------------------
# How long a quote and a bar series may be reused before refetching. Cached
# quotes are re-aged on every read, so caching never launders staleness.
# NORTHSTAR_QUOTE_CACHE_SECONDS=45
# NORTHSTAR_HISTORY_REFRESH_MINUTES=60

# --- monitoring loops ------------------------------------------------------
# Position monitoring and reconciliation run on their OWN cadences and cost no
# X requests, so a stop-loss never waits for the next X scan.
# NORTHSTAR_POSITION_MONITOR_SECONDS=60
# NORTHSTAR_RECONCILE_SECONDS=180

# --- trading controls ------------------------------------------------------
# Minimum minutes between two ENTRY attempts in the same ticker. A safety
# control, not a strategy parameter: it bounds how fast the bot can act on one
# developing story, whatever the signal says.
# NORTHSTAR_TICKER_COOLDOWN_MINUTES=30
# Maximum age of the EVIDENCE at the moment of submission, and of the proposal
# terms. Re-checked immediately before any broker call.
# NORTHSTAR_SIGNAL_TTL_MINUTES=45
# NORTHSTAR_PROPOSAL_TTL_MINUTES=15

# --- reporting -------------------------------------------------------------
# How long after the close to wait before emitting the end-of-day report, so
# late fills and the final reconciliation land first.
# NORTHSTAR_EOD_DELAY_MINUTES=10
