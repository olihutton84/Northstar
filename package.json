{
  "name": "northstar",
  "version": "0.1.0",
  "private": true,
  "description": "Northstar \u2014 Trading Lab. X Signal Bot v0.1 (X -> Signal -> Risk -> Alpaca).",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "test:unit": "npm run build && node --test dist/test/unit/*.test.js",
    "test:integration": "npm run build && node --test dist/test/integration/*.test.js",
    "test:failure": "npm run build && node --test dist/test/failure/*.test.js",
    "lab": "npm run build && node --env-file-if-exists=.env dist/src/cli/northstar.js",
    "serve": "npm run lab -- serve",
    "migrate": "npm run lab -- migrate",
    "seed": "npm run lab -- seed",
    "cycle": "npm run lab -- cycle",
    "paper": "npm run lab -- paper",
    "status": "npm run lab -- status",
    "report": "npm run lab -- report",
    "simulate": "npm run lab -- simulate",
    "readiness": "npm run lab -- readiness",
    "reconcile": "npm run lab -- reconcile",
    "replay": "npm run lab -- replay",
    "compare": "npm run lab -- compare",
    "audit": "npm run lab -- audit",
    "funnel": "npm run lab -- funnel",
    "eod": "npm run lab -- eod",
    "api": "npm run lab -- api"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0"
  }
}
